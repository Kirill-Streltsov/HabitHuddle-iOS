    "Make a habit “open to friends” to let them see it and challenge you!\n\nOnly synced habits can be shared.": {
      "comment": "Info popover for the Open to Friends toggle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache eine Gewohnheit „für Freunde sichtbar“, damit sie diese sehen und dich herausfordern können!\n\nNur synchronisierte Gewohnheiten können geteilt werden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделай привычку видимой для друзей, чтобы они могли её видеть и бросить тебе вызов!\n\nТолько синхронизированные привычки можно делать публичными."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un hábito como «visible para amigos» para que puedan verlo y retarte.\n\nSolo los hábitos sincronizados se pueden compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets une habitude «visible par les amis» pour qu'ils puissent la voir et te défier.\n\nSeules les habitudes synchronisées peuvent être partagées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi un'abitudine «aperta agli amici» per farla vedere e ricevere sfide.\n\nSolo le abitudini sincronizzate possono essere condivise."
          }
        }
      }
    },
