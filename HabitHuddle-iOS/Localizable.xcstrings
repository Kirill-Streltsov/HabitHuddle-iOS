    "%@ hasn't started any habits yet.\nSend a challenge to help get things going!" : {
      "comment" : "Empty activity state description on a friend's profile; %@ is the friend's name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keine Gewohnheiten begonnen.\nSchick eine Herausforderung, um den Anfang zu machen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hasn't started any habits yet.\nSend a challenge to help get things going!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ todavía no ha empezado ningún hábito.\n¡Envíale un reto para animarle a empezar!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas encore commencé d'habitudes.\nEnvoie un défi pour l'aider à démarrer !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha ancora iniziato nessuna abitudine.\nMandagli una sfida per aiutarlo a iniziare!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ещё не начал никаких привычек.\nОтправь ему вызов, чтобы помочь начать!"
          }
        }
      }
    },
    "%@ might be keeping their habits private, or just getting started.\nEither way, a challenge from you could be the perfect motivation!" : {
      "comment" : "Empty state description on a friend's profile; %@ is the friend's name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hält seine Gewohnheiten vielleicht privat, oder fängt gerade erst an.\nEin Reto von dir könnte die perfekte Motivation sein!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que %@ mantenga sus hábitos en privado, o que esté empezando.\nDe cualquier forma, un reto tuyo podría ser la motivación perfecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ garde peut-être ses habitudes privées, ou commence tout juste.\nDans tous les cas, un défi de ta part pourrait être la motivation parfaite !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ potrebbe tenere le sue abitudini private, o sta solo iniziando.\nIn ogni caso, una tua sfida potrebbe essere la motivazione perfetta!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ скрывает свои привычки или только начинает.\nТвой вызов может стать отличной мотивацией!"
          }
        }
      }
    },
